{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ANTLR: Generate Lexer",
      "type": "shell",
      "command": "java -jar lib/antlr-4.13.2-complete.jar src/JavaScriptLexer.g4 -o src",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Run Lexer",
      "type": "shell",
      "command": "javac -cp \"lib/*\" src/*.java ; java -cp \"src;lib/*\" Main",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$javac"]
    }
  ]
}
